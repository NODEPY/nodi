<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Theme.Nodi" parent="Theme.MaterialComponents.DayNight.DarkActionBar">
        <!-- Primary brand color. -->
        <item name="colorPrimary">@color/nodi_dark</item>
        <item name="colorPrimaryVariant">@color/nodi_surface</item>
        <item name="colorOnPrimary">@color/nodi_text</item>
        <!-- Secondary brand color. -->
        <item name="colorSecondary">@color/nodi_accent</item>
        <item name="colorSecondaryVariant">@color/nodi_accent_dark</item>
        <item name="colorOnSecondary">@color/nodi_dark</item>
        <!-- Status bar color. -->
        <item name="android:statusBarColor">?attr/colorPrimaryVariant</item>
        <!-- Customize your theme here. -->
    </style>
</resources>
