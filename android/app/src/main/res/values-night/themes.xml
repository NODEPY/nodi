<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Nodi is dark-only; both values and values-night use the same theme. -->
    <style name="Theme.Nodi" parent="Theme.MaterialComponents.DayNight.DarkActionBar">
        <item name="colorPrimary">@color/nodi_dark</item>
        <item name="colorPrimaryVariant">@color/nodi_surface</item>
        <item name="colorOnPrimary">@color/nodi_text</item>
        <item name="colorSecondary">@color/nodi_accent</item>
        <item name="colorSecondaryVariant">@color/nodi_accent_dark</item>
        <item name="colorOnSecondary">@color/nodi_dark</item>
        <item name="android:statusBarColor">@color/nodi_dark</item>
        <item name="android:navigationBarColor">@color/nodi_dark</item>
        <item name="android:windowBackground">@color/nodi_dark</item>
        <item name="android:alertDialogTheme">@style/Theme.Nodi.Dialog</item>
    </style>

    <!-- MainActivity's runtime theme: the platform theme it always used, plus branded dialogs. -->
    <style name="Theme.Nodi.Main" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:alertDialogTheme">@style/Theme.Nodi.Dialog</item>
    </style>

    <!-- Used by every android.app.AlertDialog.Builder(this) in the app. -->
    <style name="Theme.Nodi.Dialog" parent="android:Theme.Material.Dialog.Alert">
        <item name="android:windowBackground">@drawable/nodi_dialog_background</item>
        <item name="android:colorAccent">@color/nodi_accent</item>
        <item name="android:colorControlActivated">@color/nodi_accent</item>
        <item name="android:colorControlNormal">@color/nodi_muted</item>
        <item name="android:textColorPrimary">@color/nodi_text</item>
        <item name="android:textColorSecondary">@color/nodi_muted</item>
        <item name="android:textColorHint">#FF626780</item>
        <item name="android:textColorAlertDialogListItem">@color/nodi_text</item>
        <item name="android:buttonBarButtonStyle">@style/Nodi.DialogButton</item>
        <item name="android:windowMinWidthMajor">88%</item>
        <item name="android:windowMinWidthMinor">88%</item>
    </style>

    <style name="Nodi.DialogButton" parent="android:Widget.Material.Button.Borderless.Colored">
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textColor">@color/nodi_accent_text</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>
</resources>
